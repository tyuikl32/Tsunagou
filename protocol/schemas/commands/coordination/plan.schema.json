{
  "$id": "https://tsunagou.local/schema/commands/coordination.plan",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "objective": {"type": "string", "minLength": 1, "maxLength": 4096},
    "auto_wake": {"type": "boolean"},
    "wake_deadline_seconds": {"type": "number", "exclusiveMinimum": 0},
    "assignments": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "properties": {
          "assigned_worker_id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1, "maxLength": 4096},
          "task_objective": {"type": "string", "minLength": 1, "maxLength": 4096},
          "parent_task_id": {"type": "string", "minLength": 1},
          "blocks": {"type": "array", "items": {"type": "string"}},
          "dependencies": {"type": "array", "items": {"type": "string"}},
          "acceptance_conditions": {"type": "object"},
          "workspace": {"type": "object"},
          "resource_intent": {"type": "object"},
          "execution_scope": {"type": "object"}
        },
        "required": ["assigned_worker_id", "title", "task_objective"]
      }
    }
  },
  "required": ["objective", "assignments"],
  "title": "CoordinationPlanPayload",
  "type": "object"
}
