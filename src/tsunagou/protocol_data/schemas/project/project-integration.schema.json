{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsunagou.local/schema/project-integration",
  "title": "Tsunagou project integration manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "project_root_id",
    "source",
    "generated_by",
    "managed_files",
    "content_digest",
    "updated_at"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "project_id": {"type": "string", "minLength": 1},
    "project_root_id": {"type": "string", "minLength": 1},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit", "install_path_hint"],
      "properties": {
        "repository": {"type": "string", "format": "uri"},
        "ref": {"type": "string", "minLength": 1},
        "commit": {"type": ["string", "null"]},
        "install_path_hint": {"type": ["string", "null"]}
      }
    },
    "generated_by": {"type": "string", "minLength": 1},
    "managed_files": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1,
      "uniqueItems": true
    },
    "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "updated_at": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
