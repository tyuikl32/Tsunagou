{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsunagou.local/schema/commands/task.submit",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "attempt_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string"
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifact_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "validation_metadata": {
      "description": "Optional evidence records. Keep each one SHORT: only `command` and `exit_code` are required, and everything else (timestamps, tool, digests, evidence_level) is optional. Prefer pointing at where the evidence can be checked -- `evidence_refs` / `artifact_refs`, or a workspace result -- over inlining long command lines, logs or transcripts: the host parses this as JSON in one streamed response, and a long payload is what breaks it (2026-10-07: a submission with the full seven-field records killed the session with 'tool input is invalid JSON'). Main can attach the long evidence when it reviews the result.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "command": {
            "maxLength": 4096,
            "minLength": 1,
            "type": "string"
          },
          "evidence_level": {
            "enum": [
              "agent_asserted",
              "host_observed",
              "system_verified",
              "user_confirmed"
            ]
          },
          "exit_code": {
            "type": "integer"
          },
          "finished_at": {
            "format": "date-time",
            "type": "string"
          },
          "started_at": {
            "format": "date-time",
            "type": "string"
          },
          "stderr_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "stdout_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "tool": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "tool_version": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "workspace_digest": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          }
        },
        "required": [
          "command",
          "exit_code"
        ],
        "type": "object"
      },
      "maxItems": 100,
      "type": "array"
    }
  },
  "required": [
    "task_id",
    "attempt_id",
    "summary"
  ]
}
