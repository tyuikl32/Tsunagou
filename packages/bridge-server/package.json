{
  "name": "@tsunagou/bridge-server",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "files": ["dist", "protocol", "package.json"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0"
  },
  "scripts": {
    "check": "tsc -p tsconfig.json --noEmit",
    "build": "node scripts/copy-protocol.mjs && tsc -p tsconfig.json",
    "test:credentials": "pnpm run build && node --test scripts/test-credential-handoff.mjs && node scripts/smoke-late-ticket.mjs && node scripts/smoke-late-ticket.mjs --implicit-session",
    "start": "node dist/server.js"
  }
}
