{
  "$id": "https://tsunagou.local/schema/commands/message.send",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MessageSendPayload",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "recipient_agent_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "kind": {
      "type": "string",
      "default": "message"
    },
    "subject_ref": {
      "type": "string",
      "default": ""
    },
    "payload": {
      "type": "object",
      "default": {}
    },
    "priority": {
      "type": "integer",
      "default": 0
    },
    "response_contract": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean",
          "default": true
        },
        "schema": {
          "type": "object"
        }
      }
    },
    "in_reply_to": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "recipient_agent_id",
    "summary"
  ]
}
