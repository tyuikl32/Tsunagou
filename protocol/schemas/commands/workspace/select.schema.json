{
  "$id": "https://tsunagou.local/schema/commands/workspace.select",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "driver_kind": {
      "enum": [
        "shared",
        "worktree",
        "external"
      ]
    },
    "evidence_refs": {
      "type": "array"
    },
    "external_locator": {
      "minLength": 1,
      "type": "string"
    },
    "hard_constraints": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "reason": {
      "type": "string"
    },
    "repository_id": {
      "minLength": 1,
      "type": "string"
    },
    "root_binding_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "type": "array"
    },
    "task_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "driver_kind",
    "task_id"
  ],
  "type": "object"
}
