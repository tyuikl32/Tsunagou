{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsunagou.local/schema/common/problem",
  "title": "Problem",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "title", "status", "code"],
  "properties": {
    "type": {"type": "string", "format": "uri-reference"},
    "title": {"type": "string", "minLength": 1},
    "status": {"type": "integer", "minimum": 400, "maximum": 599},
    "detail": {"type": "string"},
    "instance": {"type": "string"},
    "code": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "command_id": {"anyOf": [{"$ref": "id.schema.json"}, {"type": "null"}]},
    "current_revisions": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "blockers": {"type": "array", "items": {"type": "object", "additionalProperties": false}},
    "remediation": {"type": "string"},
    "retry_after_ms": {"type": "integer", "minimum": 0}
  }
}
