{
  "$id": "https://tsunagou.local/schema/queries/credential-delivery.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CredentialDelivery",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "delivery_ref": {"type": "string", "pattern": "^delivery:[A-Za-z0-9_-]{24}$"},
    "delivery_status": {"enum": ["pending", "delivered", "consumed", "revoked", "expired"]},
    "created_at": {"$ref": "../common/timestamp.schema.json"},
    "expires_at": {"$ref": "../common/timestamp.schema.json"},
    "delivered_at": {"anyOf": [{"$ref": "../common/timestamp.schema.json"}, {"type": "null"}]},
    "recovery_expires_at": {"anyOf": [{"$ref": "../common/timestamp.schema.json"}, {"type": "null"}]},
    "consumed_at": {"anyOf": [{"$ref": "../common/timestamp.schema.json"}, {"type": "null"}]},
    "revoked_at": {"anyOf": [{"$ref": "../common/timestamp.schema.json"}, {"type": "null"}]}
  },
  "required": ["receipt_id", "delivery_ref", "delivery_status", "created_at", "expires_at", "delivered_at", "recovery_expires_at", "consumed_at", "revoked_at"]
}
