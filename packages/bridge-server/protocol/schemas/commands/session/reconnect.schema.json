{
  "$id": "https://tsunagou.local/schema/commands/session.reconnect",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "continuity_evidence": {},
    "expected_connection_epoch": {
      "minimum": 0,
      "type": [
        "integer",
        "string",
        "object"
      ]
    },
    "probe_payload": {},
    "host_binding_refresh": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"const": "codex_desktop_app"},
        "endpoint": {"type": "string", "minLength": 1},
        "host_generation": {"type": "string", "minLength": 1},
        "app_version": {"type": ["string", "null"]},
        "plugin_version": {"type": ["string", "null"]}
      },
      "required": ["provider", "endpoint", "host_generation"]
    },
    "reconnect_nonce": {}
  },
  "required": [
    "continuity_evidence",
    "expected_connection_epoch",
    "probe_payload",
    "reconnect_nonce"
  ],
  "title": "SessionReconnectPayload",
  "type": "object"
}
