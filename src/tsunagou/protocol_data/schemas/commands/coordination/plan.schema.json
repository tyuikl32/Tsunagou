{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tsunagou.local/schema/commands/coordination.plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "assignments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "auto_wake": {
      "type": "boolean"
    }
  },
  "required": [
    "objective",
    "assignments"
  ]
}
