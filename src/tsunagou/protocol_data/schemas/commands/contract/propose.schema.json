{
  "$id": "https://tsunagou.local/schema/commands/contract.propose",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "$defs": {
    "participant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot", "agent_id"],
      "properties": {
        "slot": {"type": "string", "pattern": "\\S"},
        "agent_id": {"type": "string", "pattern": "\\S"}
      }
    }
  },
  "properties": {
    "contract_id": {
      "minLength": 1,
      "type": "string"
    },
    "contract_kind": {},
    "input_refs": {},
    "participants_optional": {
      "type": "array", "default": [], "items": {"$ref": "#/$defs/participant"}
    },
    "participants_required": {
      "type": "array", "minItems": 1, "items": {"$ref": "#/$defs/participant"}
    },
    "payload": {"type": "object"},
    "subject_ref": {
      "minLength": 1,
      "type": "string"
    },
    "supersedes_id": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "participants_required",
    "payload"
  ],
  "title": "ContractProposePayload",
  "type": "object"
}
